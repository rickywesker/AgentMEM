# === 服务 ===
AGENTMEM_HOST=0.0.0.0
AGENTMEM_PORT=8080
# 评测平台鉴权：Token / Bearer / X-Api-Key 三选一，提交时在平台侧登记
AGENTMEM_API_KEY=

# === 数据库 ===
DATABASE_URL=postgresql://agentmem:agentmem@localhost:5432/agentmem

# === LLM ===
# 每档独立配置 base/key/model，换供应商只改这里，不动业务代码。

# 写入侧事实抽取：默认关闭（留空即关闭）。
# 实测在 LoCoMo n=500 上比不抽取低 2.8 分：抽出来的事实会和原文消息抢候选池，
# 导致返回的 100 条选自更差的集合。temporal 类别掉得最多（58.0 → 44.4）。
# 想重新开启就填 base/key/model。详见 README「What the measurements said」。
EXTRACT_API_BASE=
EXTRACT_API_KEY=
EXTRACT_MODEL=gpt-4o-mini

# 向量召回
EMBED_API_BASE=https://yunwu.ai/v1
EMBED_API_KEY=
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536

# === 并发 ===
# 在途 LLM 请求上限。评测方用 64 个 worker 打 Add，每个 Add 有抽取+embedding
# 两次调用，不限流会给上游造成 ~128 并发并开始吃 429。
AGENTMEM_LLM_CONCURRENCY=48

# === 检索调参（全部由 harness 扫出来，不是拍脑袋）===
# RETURN_N 顶到契约上限 100：LoCoMo 上得分随返回条数单调上升（3 条 41.3 → 100 条 60.7）
AGENTMEM_RETURN_N=100
AGENTMEM_POOL_N=140
# 字符预算：条数不是跨数据集通用的单位。LoCoMo 每条约 147 字符，100 条才 17k；
# LongMemEval 每条是 ShareGPT 长度，同样 100 条就是 112k 字符（约 28k token）。
# 50k 对 LoCoMo 是空操作，对长记录数据集起保护作用。0 = 关闭。
AGENTMEM_CHAR_BUDGET=50000
# 仅在开启 EXTRACT 时有意义：事实占返回槽位的比例
AGENTMEM_FACT_SHARE=0.75

# === 仅 harness 使用：复刻评测平台的固定契约 ===
# 平台锁死 gpt-4o-mini + temperature 0，这里必须逐字对齐，否则离线分数失真
ANSWER_API_BASE=https://yunwu.ai/v1
ANSWER_API_KEY=
ANSWER_MODEL=gpt-4o-mini

JUDGE_API_BASE=https://yunwu.ai/v1
JUDGE_API_KEY=
JUDGE_MODEL=gpt-4o-mini
