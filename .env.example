# === 服务 ===
AGENTMEM_HOST=0.0.0.0
AGENTMEM_PORT=8080
# 评测平台鉴权：Token / Bearer / X-Api-Key 三选一，提交时在平台侧登记
AGENTMEM_API_KEY=

# === 数据库 ===
DATABASE_URL=postgresql://agentmem:agentmem@localhost:5432/agentmem

# === LLM ===
# 每档独立配置 base/key/model，换供应商只改这里，不动业务代码。

# 写入侧事实抽取：默认关闭（留空即关闭）。
# 写入侧事实抽取。抽出来的事实只作为检索索引，命中后返回的是它的来源原文轮次，
# 事实本身永不进入答案上下文——这是它能有正收益的前提。早期让事实和原文抢
# 返回槽位的写法实测 temporal −17、adversarial −26。
# 学术榜要求 Add/Search 内的模型必须是 gpt-4o-mini，这里不要换成别的。
# 留空即关闭，降级为纯原文索引（LoCoMo 64.0 vs 开启 64.4）。
EXTRACT_API_BASE=https://api.openai.com/v1
EXTRACT_API_KEY=
EXTRACT_MODEL=gpt-4o-mini

# 向量召回。任何 OpenAI 形状的 /embeddings 端点都能用，Voyage 也是这个形状。
# EMBED_DIM 必须和模型的实际维度一致，写错了向量会按错误的长度解包。
#   voyage-4-large / voyage-4 / voyage-4-lite  → 1024（当前部署用的是 4-large）
#   text-embedding-3-small                     → 1536
# 部署在大陆时先确认端点连得上：api.openai.com 走不通，api.voyageai.com 可以。
EMBED_API_BASE=https://api.voyageai.com/v1
EMBED_API_KEY=
EMBED_MODEL=voyage-4-large
EMBED_DIM=1024

# === 并发 ===
# 在途 LLM 请求上限。评测方用 64 个 worker 打 Add，每个 Add 有抽取+embedding
# 两次调用，不限流会给上游造成 ~128 并发并开始吃 429。
AGENTMEM_LLM_CONCURRENCY=48

# === 检索调参（全部由 harness 扫出来，不是拍脑袋）===
# RETURN_N 顶到契约上限 100：LoCoMo 上得分随返回条数单调上升（3 条 41.3 → 100 条 60.7）
AGENTMEM_RETURN_N=100
AGENTMEM_POOL_N=140
# 字符预算：条数不是跨数据集通用的单位。LoCoMo 每条约 147 字符，100 条才 17k；
# LongMemEval 每条是 ShareGPT 长度，同样 100 条就是 112k 字符（约 28k token）。
# 50k 对 LoCoMo 是空操作，对长记录数据集起保护作用。0 = 关闭。
AGENTMEM_CHAR_BUDGET=50000
# 仅在开启 EXTRACT 时有意义：事实占返回槽位的比例
AGENTMEM_FACT_SHARE=0.75

# === 仅 harness 使用：复刻评测平台的固定契约 ===
# 平台锁死 gpt-4o-mini + temperature 0，这里必须逐字对齐，否则离线分数失真
ANSWER_API_BASE=https://api.openai.com/v1
ANSWER_API_KEY=
ANSWER_MODEL=gpt-4o-mini

JUDGE_API_BASE=https://api.openai.com/v1
JUDGE_API_KEY=
JUDGE_MODEL=gpt-4o-mini
